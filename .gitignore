# Local toolchain and dependencies (rebuild with the README's setup steps)
.venv/
.tools/
web/node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# VerilogEval is downloaded, not vendored (MIT, NVIDIA): see README setup
data/raw/

