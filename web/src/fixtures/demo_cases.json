    {
      "problem_id": "Prob060_m2014_q4k",
      "spec": "Implement a shift register with four D flip-flops in series. resetn is an active-low synchronous reset. out is the output of the last flip-flop.",
      "v0": {
        "version": 0,
        "official_pass": false,
        "code": "module TopModule (\n  input clk,\n  input resetn,\n  input in,\n  output out\n);\n\n  reg q1, q2, q3, q4;\n\n  always @(posedge clk) begin\n    if (!resetn) begin\n      q1 = 1'b0;\n      q2 = 1'b0;\n      q3 = 1'b0;\n      q4 = 1'b0;\n    end else begin\n      q1 = in;\n      q2 = q1;\n      q3 = q2;\n      q4 = q3;\n    end\n  end\n\n  assign out = q4;\n\nendmodule\n"
      },
      "vbest": {
        "version": 4,
        "official_pass": true,
        "code": "module TopModule (\n  input clk,\n  input resetn,\n  input in,\n  output out\n);\n\n  reg [3:0] sr;\n\n  always @(posedge clk) begin\n    if (!resetn)\n      sr <= 4'b0;\n    else\n      sr <= {sr[2:0], in};\n  end\n\n  assign out = sr[3];\n\nendmodule\n"
      },
      "explanation": {
        "round": 1,
        "summary": "Use non-blocking assignments (<=) inside clocked always blocks",
        "reasoning": "Version 0 used blocking \"=\" in the clocked block, so q1..q4 all took the new input in the same cycle and the 4-cycle delay collapsed to 1. The very first rule the Builder coach learned, in round 1, is to use non-blocking \"<=\" in clocked blocks."
      },
